{
    "name": "loomux/compat-php",
    "description": "A loomux compatibility fixture.",
    "type": "project",
    "license": "MIT",
    "require-dev": {
        "phpstan/phpstan": "2.3.5",
        "phpunit/phpunit": "12.5.43",
        "squizlabs/php_codesniffer": "4.0.4"
    },
    "autoload": {
        "psr-4": {
            "Calc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Calc\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
