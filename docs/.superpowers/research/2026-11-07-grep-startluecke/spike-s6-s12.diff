diff --git a/internal/code/grep/zz_spike_whole.go b/internal/code/grep/zz_spike_whole.go
new file mode 100644
index 00000000..dc253d40
--- /dev/null
+++ b/internal/code/grep/zz_spike_whole.go
@@ -0,0 +1,81 @@
+package grep
+
+// SPIKE (throwaway) WHOLE: one regex pass per file instead of one per line,
+// for patterns that can never match a newline.
+
+import (
+	"bytes"
+	"os"
+	"regexp"
+	"regexp/syntax"
+)
+
+// spikeNoNewline reports whether re can never match a '\n': then a line has
+// a match exactly when a whole-buffer match starts in it.
+func spikeNoNewline(re *syntax.Regexp) bool {
+	switch re.Op {
+	case syntax.OpAnyChar, syntax.OpBeginText, syntax.OpEndText:
+		// \A and \z anchor each line in the per-line scan, the file here.
+		return false
+	case syntax.OpCharClass:
+		for i := 0; i+1 < len(re.Rune); i += 2 {
+			if re.Rune[i] <= '\n' && '\n' <= re.Rune[i+1] {
+				return false
+			}
+		}
+		return true
+	case syntax.OpLiteral:
+		for _, r := range re.Rune {
+			if r == '\n' {
+				return false
+			}
+		}
+		return true
+	}
+	for _, sub := range re.Sub {
+		if !spikeNoNewline(sub) {
+			return false
+		}
+	}
+	return true
+}
+
+// spikeWhole compiles the (?m) form of re when no match can cross a line.
+func spikeWhole(re *regexp.Regexp) *regexp.Regexp {
+	if os.Getenv("LMX_SPIKE_WHOLE") != "1" {
+		return nil
+	}
+	parsed, err := syntax.Parse(re.String(), syntax.Perl)
+	if err != nil || !spikeNoNewline(parsed) {
+		return nil
+	}
+	whole, err := regexp.Compile("(?m)" + re.String())
+	if err != nil {
+		return nil
+	}
+	return whole
+}
+
+// spikeScanWhole maps whole-buffer matches to their lines.
+func spikeScanWhole(data []byte, whole *regexp.Regexp) spikeScanned {
+	var out spikeScanned
+	line, pos, last := 1, 0, -1
+	for _, loc := range whole.FindAllIndex(data, -1) {
+		line += bytes.Count(data[pos:loc[0]], []byte{'\n'})
+		pos = loc[0]
+		if line == last {
+			continue
+		}
+		last = line
+		start := bytes.LastIndexByte(data[:loc[0]], '\n') + 1
+		end := bytes.IndexByte(data[loc[0]:], '\n')
+		if end < 0 {
+			end = len(data)
+		} else {
+			end += loc[0]
+		}
+		out.lines = append(out.lines, line)
+		out.texts = append(out.texts, string(data[start:end]))
+	}
+	return out
+}
