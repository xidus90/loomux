diff --git a/internal/code/corpus/zz_spike_gob.go b/internal/code/corpus/zz_spike_gob.go
new file mode 100644
index 00000000..e86a64cf
--- /dev/null
+++ b/internal/code/corpus/zz_spike_gob.go
@@ -0,0 +1,48 @@
+package corpus
+
+// SPIKE (throwaway) RECGOB: a gob mirror beside a JSON record, refreshed when
+// the JSON file is newer. Decoding gob is the thing measured.
+
+import (
+	"bytes"
+	"encoding/gob"
+	"encoding/json"
+	"os"
+)
+
+// SpikeReadRecord decodes the JSON record at path into v, through the gob
+// mirror when LMX_SPIKE_RECGOB=1.
+func SpikeReadRecord(path string, v any) error {
+	if !spikeOn("RECGOB") {
+		b, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		return json.Unmarshal(b, v)
+	}
+	mirror := path + ".gob"
+	js, jerr := os.Stat(path)
+	if jerr != nil {
+		return jerr
+	}
+	if gs, err := os.Stat(mirror); err == nil && !gs.ModTime().Before(js.ModTime()) {
+		if b, err := os.ReadFile(mirror); err == nil && gob.NewDecoder(bytes.NewReader(b)).Decode(v) == nil {
+			return nil
+		}
+	}
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return err
+	}
+	if err := json.Unmarshal(b, v); err != nil {
+		return err
+	}
+	var buf bytes.Buffer
+	if gob.NewEncoder(&buf).Encode(v) == nil {
+		tmp := mirror + ".tmp"
+		if os.WriteFile(tmp, buf.Bytes(), 0o644) == nil {
+			_ = os.Rename(tmp, mirror)
+		}
+	}
+	return nil
+}
